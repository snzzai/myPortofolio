---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import ThreeBackground from '../components/ThreeBackground.astro'; // Importnya di sini

const skills = [
  "Leadership",
  "Full stack web development",
  "AI Fluency",
  "Google Workspace"
];

const experiences = [
  {
    role: "CRM & IT Support",
    organization: "Souvenir Jogja Ira (Local MSME)",
    location: "Sleman, Yogyakarta, Indonesia",
    period: "Jul 2026 - Present",
    highlights: [
      "Build operational dashboards using Google Workspace, formulas, and Google Apps Script to support business workflows and information tracking.",
      "Coordinate worker schedules and task handoffs during an operational transition.",
      "Apply workflow automation to improve organization and visibility across daily operations."
    ]
  },
  {
    role: "Leader",
    organization: "KOMINFO Sleman Specialized Scout Unit",
    location: "Sleman, Yogyakarta, Indonesia",
    period: "2025 - Present",
    highlights: [
      "Lead and coordinate team activities, including member responsibilities, schedules, and task execution.",
      "Facilitate communication and collaboration among team members to support effective program execution."
    ]
  },
  {
    role: "Leader / Pradana Putri (Female Scout Council President)",
    organization: "Stembayo Scout, SMKN 2 Depok",
    location: "Sleman, Yogyakarta, Indonesia",
    period: "2023 - 2024",
    highlights: [
      "Led and coordinated 80+ student leaders across the scout council, supporting programs for 700+ Grade 10 students.",
      "Partnered with 10+ adult supervisors and school leadership to align schedules, budgets, and event requirements.",
      "Managed communication across organizational levels and resolved live operational issues during events.",
      "Built leadership, delegation, and public-communication skills through large-scale student organization management."
    ]
  },
  {
    role: "Full-Stack Web Development",
    organization: "Competency Examination Project, SMKN 2 Depok",
    location: "Sleman, Yogyakarta, Indonesia",
    period: "2025",
    highlights: [
      "Built a management system using PHP and MySQL to track and organize internship data for SMKN 2 Depok's Information, Networking, and Application (SIJA A) class."
    ]
  },
  {
    role: "Custom WordPress Web Portfolio",
    organization: "P5BK Innovation Exhibition, SMKN 2 Depok",
    location: "Sleman, Yogyakarta, Indonesia",
    period: "2025",
    highlights: [
      "Customized and built a WordPress portfolio site to present the class's innovation project at a school-wide exhibition; the class placed 1st among participating teams."
    ]
  }
];

const certifications = [
  {
    title: "Cloud Computing Installation & Software Development with Database",
    issuer: "LSP SMK Negeri 2 Depok (Accredited by BNSP)",
    date: "Dec 2025",
    details: "Vocational Competency Certification Body - National Professional Certification Authority."
  },
  {
    title: "MikroTik Certified Network Associate (MTCNA)",
    issuer: "MikroTik",
    date: "May 2025",
    details: "Router Configuration, Routing, Firewall Management, Network Troubleshooting."
  }
];
---

<Layout title="Home">
  <!-- SECTION 1: HOME -->
  <section id="home" class="hero-section">
    <!-- EFEK THREE.JS KHUSUS SECTION HOME -->
    <ThreeBackground />

    <div class="hero-content">
      <span class="badge">Young Leader & Developer</span>
      <h1>Isnaini Nur Wahyuningsih</h1>
      <p class="description">
        Young leader with the ability to understand problems, design system, lead processes, and develop the solution.
      </p>

      <div class="skills-container">
        <h3>Core Skills</h3>
        <div class="skills-grid">
          {skills.map((skill) => (
            <div class="skill-card">
              <span class="dot"></span>
              <span>{skill}</span>
            </div>
          ))}
        </div>
      </div>
      
      <div class="cta-buttons">
        <a href="https://linkedin.com/in/isnaininw" target="_blank" class="btn-primary">Connect on LinkedIn</a>
        <a href="#experience" class="btn-secondary">Explore Experience</a>
      </div>
    </div>
  </section>

  <!-- SECTION 2: EXPERIENCE -->
  <section id="experience" class="section-container">
    <div class="section-header">
      <h2>Experience</h2>
      <div class="header-line"></div>
    </div>

    <div class="timeline">
      {experiences.map((exp) => (
        <div class="timeline-card">
          <div class="card-header">
            <div>
              <h3>{exp.role}</h3>
              <p class="org-name">{exp.organization}</p>
            </div>
            <div class="period-badge">{exp.period}</div>
          </div>
          <p class="location">{exp.location}</p>
          <ul class="highlights">
            {exp.highlights.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- SECTION 3: CERTIFICATIONS -->
  <section id="certifications" class="section-container">
    <div class="section-header">
      <h2>Certifications</h2>
      <div class="header-line"></div>
    </div>

    <div class="cert-grid">
      {certifications.map((cert) => (
        <div class="cert-card">
          <div class="cert-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15l-2 5l9-9l-9-9l2 5l-8 4l8 4z"></path></svg>
          </div>
          <div class="cert-info">
            <span class="cert-date">{cert.date}</span>
            <h3>{cert.title}</h3>
            <p class="issuer">{cert.issuer}</p>
            <p class="details">{cert.details}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  .hero-section {
    position: relative; /* Penting agar background Three.js terkurung di section Home saja */
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 8rem 8% 4rem;
    max-width: 1200px;
    margin: 0 auto;
    overflow: hidden;
  }

  .hero-content {
    position: relative;
    z-index: 1; /* Supaya teks berada di atas canvas Three.js */
    max-width: 800px;
  }

  .badge {
    background: rgba(10, 41, 71, 0.6);
    border: 1px solid #0A2947;
    color: #ffffff;
    padding: 0.4rem 1rem;
    border-radius: 20px;
    font-size: 0.85rem;
    letter-spacing: 0.5px;
    display: inline-block;
    margin-bottom: 1.5rem;
  }

  h1 {
    font-size: clamp(2.5rem, 5vw, 4.2rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    color: #ffffff;
  }

  .description {
    font-size: 1.2rem;
    color: #94a3b8;
    line-height: 1.6;
    margin-bottom: 2.5rem;
  }

  .skills-container {
    margin-bottom: 2.5rem;
  }

  .skills-container h3 {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #94a3b8;
    margin-bottom: 1rem;
  }

  .skills-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .skill-card {
    background: rgba(10, 41, 71, 0.3);
    border: 1px solid rgba(10, 41, 71, 0.8);
    padding: 0.5rem 1rem;
    border-radius: 6px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: #ffffff;
    backdrop-filter: blur(4px);
  }

  .dot {
    width: 6px;
    height: 6px;
    background-color: #ffffff;
    border-radius: 50%;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
  }

  .btn-primary {
    background: #0A2947;
    color: #ffffff;
    padding: 0.8rem 1.8rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
    border: 1px solid #0A2947;
  }

  .btn-primary:hover {
    background: #123d68;
    box-shadow: 0 0 20px rgba(10, 41, 71, 0.5);
  }

  .btn-secondary {
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    padding: 0.8rem 1.8rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  .section-container {
    padding: 6rem 8%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    margin-bottom: 3rem;
  }

  .section-header h2 {
    font-size: 2rem;
    color: #ffffff;
    margin-bottom: 0.5rem;
  }

  .header-line {
    width: 60px;
    height: 4px;
    background: #0A2947;
    border-radius: 2px;
  }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .timeline-card {
    background: rgba(10, 41, 71, 0.25);
    border: 1px solid rgba(10, 41, 71, 0.6);
    border-radius: 12px;
    padding: 1.8rem;
    backdrop-filter: blur(8px);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .timeline-card:hover {
    transform: translateY(-3px);
    border-color: #0A2947;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .card-header h3 {
    font-size: 1.25rem;
    color: #ffffff;
  }

  .org-name {
    color: #94a3b8;
    font-weight: 500;
  }

  .period-badge {
    background: #0A2947;
    color: #ffffff;
    font-size: 0.8rem;
    padding: 0.3rem 0.8rem;
    border-radius: 4px;
  }

  .location {
    font-size: 0.85rem;
    color: #64748b;
    margin: 0.5rem 0 1rem;
  }

  .highlights {
    padding-left: 1.2rem;
    color: #cbd5e1;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .highlights li {
    margin-bottom: 0.4rem;
  }

  .cert-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .cert-card {
    background: rgba(10, 41, 71, 0.2);
    border: 1px solid rgba(10, 41, 71, 0.6);
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    gap: 1rem;
    backdrop-filter: blur(6px);
  }

  .cert-icon {
    background: #0A2947;
    width: 44px;
    height: 44px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .cert-date {
    font-size: 0.75rem;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .cert-info h3 {
    font-size: 1.05rem;
    color: #ffffff;
    margin: 0.2rem 0;
  }

  .issuer {
    font-size: 0.85rem;
    color: #94a3b8;
    font-weight: 500;
  }

  .details {
    font-size: 0.85rem;
    color: #64748b;
    margin-top: 0.5rem;
  }
</style>